# Copy to .env.local (never commit real values). On Vercel, set these in Project → Settings → Environment Variables.

# Neon pooled connection (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon direct (unpooled) connection. Used by Prisma migrations and the legacy import script.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Random secret, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Optional: parish GCash details shown on the GCash payment step (public, not secret).
# If PARISH_GCASH_NUMBER is empty, visitors are told to ask the parish office.
PARISH_GCASH_NUMBER=""
PARISH_GCASH_NAME="Church of San Antonio de Padua"
