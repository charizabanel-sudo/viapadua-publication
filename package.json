{
  "name": "viapadua",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:db": "tsx --test --test-concurrency=1 tests/db/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:import-legacy": "tsx scripts/import-legacy.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:rename": "tsx scripts/rename-admin.ts",
    "legacy:static": "node app.js",
    "test:browser": "node tests/browser/verify.mjs",
    "users:audit": "tsx scripts/audit-users.ts"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/mrs-saint-delafield": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "file-type": "^22.2.0",
    "html-to-image": "^1.11.13",
    "next": "^16.4.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "playwright": "^1.64.1",
    "prisma": "^7.10.1",
    "selfsigned": "^5.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
